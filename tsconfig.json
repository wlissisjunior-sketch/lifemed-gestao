{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react", "jsxFactory": "React.createElement", "jsxFragmentFactory": "React.Fragment",
    "strict": true, "noEmit": true, "skipLibCheck": true, "allowSyntheticDefaultImports": true, "esModuleInterop": true, "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["vite/client"], "noImplicitAny": false
  },
  "include": ["src"]
}
